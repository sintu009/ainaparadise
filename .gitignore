logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing / Coverage ────────────────────────────────────
coverage/
.nyc_output/

# ── OS files ──────────────────────────────────────────────
