backend/uploads/*
!backend/uploads/.gitkeep

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo
tsconfig.node.tsbuildinfo
vite.config.d.ts
vite.config.js

